{
  "name": "consulta-cnpj-ws",
  "version": "4.0.0",
  "description": "Consulta de CNPJ (numérico e alfanumérico) na base da Receita Federal via OpenCNPJ. Zero dependências, TypeScript, ESM e CommonJS.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:integration": "node --test __tests__/integracao/cnpj.integracao.js",
    "test:types": "tsc --noEmit --strict --esModuleInterop --target es2022 --module commonjs --lib es2022,dom __tests__/tipos/uso.ts && tsc --noEmit --strict --module node16 --moduleResolution node16 --lib es2022,dom __tests__/esm/uso.mts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jos3duardo/cnpj-ws.git"
  },
  "bugs": {
    "url": "https://github.com/jos3duardo/cnpj-ws"
  },
  "keywords": [
    "cnpj",
    "consulta cnpj",
    "cnpj alfanumérico",
    "receita federal",
    "opencnpj",
    "validar cnpj",
    "validação cnpj",
    "empresa",
    "brasil",
    "brazil",
    "cnpj lookup",
    "brazilian company"
  ],
  "author": "José Eduardo <jos3duardolopes@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/jos3duardo/cnpj-ws#readme"
}
